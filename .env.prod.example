# Copy this file to .env.prod and replace every change-me value.

POSTGRES_DB=filedrop
POSTGRES_USER=filedrop
POSTGRES_PASSWORD=change-me

FILEDROP_REDIS_PASSWORD=change-me
FILEDROP_REDIS_DATABASE=0

# The Amazon S3 bucket must already exist in this region.
FILEDROP_S3_REGION=change-me
FILEDROP_S3_BUCKET=change-me

# Prefer an IAM role. Set these only when static AWS credentials are required.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

FILEDROP_BASE_URL=https://files.example.com
# Generate with: openssl rand -base64 32
FILEDROP_MASTER_KEY=change-me
FILEDROP_MASTER_KEY_VERSION=1

FILEDROP_HTTP_PORT=80
FILEDROP_PROXY_TIMEOUT=15m
FILEDROP_CLAMAV_READ_TIMEOUT=150s
FILEDROP_LOG_LEVEL=INFO

FILEDROP_REQUEST_RATE_LIMIT=100
FILEDROP_REQUEST_RATE_WINDOW=1m
FILEDROP_UPLOAD_RATE_LIMIT=5
FILEDROP_UPLOAD_RATE_WINDOW=1m
