{
    admin off
    auto_https off
}

http://:8081 {
    respond /health "OK" 200
}

:80 {
    encode zstd gzip

    root * /srv
    try_files {path} /index.html
    file_server

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), geolocation=(), microphone=()"
        -Server
    }

    log {
        output stdout
        format json
    }
}
