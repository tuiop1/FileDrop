apiVersion: v1
kind: Secret
metadata:
  name: filedrop-secrets
  namespace: filedrop
type: Opaque
stringData:
  # These two values must match. Generate with: openssl rand -hex 32
  POSTGRES_PASSWORD: change-me-postgres-password
  SPRING_DATASOURCE_PASSWORD: change-me-postgres-password

  # Generate independently with: openssl rand -hex 32
  SPRING_DATA_REDIS_PASSWORD: change-me-redis-password

  # Must be a Base64-encoded 32-byte key. Generate with:
  # openssl rand -base64 32
  # Back up this value securely; changing or losing it can make stored files unusable.
  FILEDROP_MASTER_KEY: change-me-base64-encoded-32-byte-key
