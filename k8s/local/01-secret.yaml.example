apiVersion: v1
kind: Secret
metadata:
  name: filedrop-secrets
  namespace: filedrop
type: Opaque
stringData:
  # These two values must match.
  POSTGRES_PASSWORD: change-me-postgres-password
  SPRING_DATASOURCE_PASSWORD: change-me-postgres-password

  # MinIO administrator credentials used by the initialization Job.
  MINIO_ROOT_USER: minioadmin
  MINIO_ROOT_PASSWORD: change-me-minio-root-password

  # Credentials created by the initialization Job and used by FileDrop.
  FILEDROP_S3_ACCESS_KEY: filedrop
  FILEDROP_S3_SECRET_KEY: change-me-filedrop-s3-secret
